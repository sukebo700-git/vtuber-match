rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /streamers/{streamerId} {
      allow read: if resource.data.is_visible != false;
      allow create, update: if false;
      allow delete: if false;
    }

    match /likes/{likeId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.streamer_id is string;
      allow update, delete: if false;
    }

    match /applications/{applicationId} {
      allow create: if true
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.youtube_url is string
        && request.resource.data.description is string
        && request.resource.data.thumbnails is list
        && request.resource.data.thumbnails.size() <= 3
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 5;
      allow read, update: if false;
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read, create, update, delete: if false;
    }

    match /users/{userId} {
      allow read, update: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // コラボお誘い機能: 全てサーバーAPI(Admin SDK)経由のみで読み書きする。
    // クライアントSDKからの直接アクセスは全面拒否(未定義コレクションはデフォルト拒否だが、
    // 意図を明文化し将来の誤設定を防ぐため明示的に書く)。
    match /collaboration_requests/{requestId} {
      allow read, write: if false;
    }
    match /collaboration_usage/{usageId} {
      allow read, write: if false;
    }
    match /collaboration_pairs/{pairId} {
      allow read, write: if false;
    }
    match /collaboration_contacts/{streamerId} {
      allow read, write: if false;
    }
    match /collaboration_blocks/{blockId} {
      allow read, write: if false;
    }
    match /collaboration_reports/{reportId} {
      allow read, write: if false;
    }
    match /system_usage/{usageId} {
      allow read, write: if false;
    }
  }
}
